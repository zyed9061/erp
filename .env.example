DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# Compte administrateur créé par `npm run db:seed`.
# En production, le mot de passe doit faire 12 caractères minimum et ne pas venir des exemples (sinon le programme refuse).
ADMIN_EMAIL=admin@example.tn
ADMIN_PASSWORD=ChangeMe-12345
ADMIN_NAME=Administrateur

# E-mail : sans SMTP_HOST, aucun e-mail réel n'est envoyé (un résumé s'affiche dans la console du serveur)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Facturation <no-reply@example.tn>
# Le chiffrement (STARTTLS ou TLS direct, TLS 1.2 minimum) est obligatoire. Mettre true seulement pour un serveur de test local sans chiffrement.
# SMTP_ALLOW_INSECURE=false

# Active /api/cron/reminders et /api/cron/recurring (en-tête Authorization: Bearer <secret>) pour un planificateur externe ; vide = désactivé
CRON_SECRET=

# Diagnostic de tout ce qui précède, sans afficher de secret : npm run check:config

# Mode démonstration (projet d'exercice) : TTN, signature électronique et QR code SIMULÉS, aucune valeur légale.
# À laisser vide pour tout usage réel. npm run dev:local l'active automatiquement.
# DEMO_MODE=true
