DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# Compte administrateur créé par `npm run db:seed`
ADMIN_EMAIL=admin@example.tn
ADMIN_PASSWORD=ChangeMe-12345
ADMIN_NAME=Administrateur

# E-mail : sans SMTP_HOST, aucun e-mail réel n'est envoyé (un résumé s'affiche dans la console du serveur)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Facturation <no-reply@example.tn>

# Active /api/cron/reminders et /api/cron/recurring (en-tête Authorization: Bearer <secret>) pour un planificateur externe ; vide = désactivé
CRON_SECRET=
