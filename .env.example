DATABASE_URL="postgresql://erp:erp@127.0.0.1:5433/erp_facturation?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="change-me-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Assistant (OpenAI): answers from the database only, through read-only query tools.
# Leave OPENAI_API_KEY empty to hide the assistant.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1"

# Invoices > Extract Invoice: base URL of the PaddleOCR receipt service (PadellOcr project, started
# with run.ps1), e.g. http://127.0.0.1:8000. Called server-side only, so it can stay bound to localhost.
# Leave empty to show a "not configured" notice.
OCR_APP_URL=""
